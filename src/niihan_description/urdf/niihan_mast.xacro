<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       NIIHAN central sensor mast, mounted mid-body on the chassis.
       Height above chassis top is mast_height (see niihan_properties.xacro).
       Provides mounting frames (fixed joints) for the sensor suite:
       360 camera ring, PTZ camera, thermal camera, 3D LiDAR.
       Actual sensor links/plugins are added in niihan_sensors*.xacro
       and attach to these mount frames, keeping this file purely
       structural.
       ============================================================ -->

  <xacro:macro name="niihan_mast" params="parent">

    <joint name="mast_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="mast_link"/>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
    </joint>

    <link name="mast_link">
      <visual>
        <origin xyz="0.075 0 ${mast_height/2}" rpy="0 -0.32 0"/>
        <geometry>
          <box size="0.055 0.055 ${mast_height}"/>
        </geometry>
        <material name="mast_dark_grey">
          <color rgba="0.55 0.56 0.57 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.075 0 ${mast_height/2}" rpy="0 -0.32 0"/>
        <geometry>
          <box size="0.055 0.055 ${mast_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertia mass="0.8" x="0.055" y="0.055" z="${mast_height}"/>
    </link>

    <gazebo reference="mast_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Mount frame at mast top: 360 camera ring + LiDAR + thermal share the head plate -->
    <joint name="mast_head_joint" type="fixed">
      <parent link="mast_link"/>
      <child link="mast_head_link"/>
      <origin xyz="0 0 ${mast_height}" rpy="0 0 0"/>
    </joint>

    <link name="mast_head_link">
      <visual>
        <geometry>
          <cylinder radius="0.075" length="0.045"/>
        </geometry>
        <material name="mast_head_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="0.015 0 -0.055" rpy="0 0 0"/>
        <geometry><box size="0.16 0.10 0.075"/></geometry>
        <material name="mast_camera_bar"><color rgba="0.16 0.17 0.18 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="0.015 0 -0.055" rpy="0 0 0"/>
        <geometry><box size="0.12 0.12 0.035"/></geometry>
        <material name="mast_camera_face"><color rgba="0.04 0.05 0.055 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.06" length="0.02"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="0.3" r="0.06" h="0.02"/>
    </link>

    <gazebo reference="mast_head_link">
      <material>Gazebo/Black</material>
    </gazebo>

    <!-- PTZ camera mount: lower on the mast, forward-facing, below the head plate -->
    <joint name="ptz_mount_joint" type="fixed">
      <parent link="mast_link"/>
      <child link="ptz_mount_link"/>
      <origin xyz="0.03 0 ${mast_height*0.6}" rpy="0 0 0"/>
    </joint>

    <link name="ptz_mount_link">
      <visual>
        <geometry>
          <box size="0.03 0.03 0.03"/>
        </geometry>
        <material name="ptz_mount_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.03 0.03"/>
        </geometry>
      </collision>
      <xacro:box_inertia mass="0.1" x="0.03" y="0.03" z="0.03"/>
    </link>

    <gazebo reference="ptz_mount_link">
      <material>Gazebo/Grey</material>
    </gazebo>

  </xacro:macro>

</robot>
