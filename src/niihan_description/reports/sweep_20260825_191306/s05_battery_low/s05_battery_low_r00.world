<?xml version='1.0'?>
<sdf version='1.8'>
  <world name='niihan_patrol_world'>

    <physics name='default_physics' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Patrol corridor: two parallel walls, 2.5m apart, running 20m along X, centered at origin -->
    <model name='corridor_wall_north'>
      <static>true</static>
      <pose>0 1.25 1.0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>20 0.2 2.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>20 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.65 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='corridor_wall_south'>
      <static>true</static>
      <pose>0 -1.25 1.0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>20 0.2 2.0</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>20 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.65 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Charging dock at the west end of the corridor (x = -9) -->
    <model name='charging_dock'>
      <static>true</static>
      <pose>-9 0 0.05 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.0 1.2 0.1</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.0 1.2 0.1</size></box></geometry>
          <material>
            <ambient>0.1 0.6 0.1 1</ambient>
            <diffuse>0.15 0.7 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='dock_marker_post'>
      <static>true</static>
      <pose>-9 0.7 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><cylinder><radius>0.05</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.05</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.2 0.1 1</ambient>
            <diffuse>0.9 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Geofence boundary markers at east end of corridor (x = 9), used by GNSS/geofence scenarios -->
    <model name='geofence_marker_east'>
      <static>true</static>
      <pose>9 0 0.4 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry><box><size>0.1 2.4 0.8</size></box></geometry>
          <material>
            <ambient>0.9 0.7 0.1 0.5</ambient>
            <diffuse>0.9 0.7 0.1 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
