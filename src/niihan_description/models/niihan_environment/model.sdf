<?xml version="1.0"?>

<sdf version="1.9">

  <model name="niihan_environment">

    <static>true</static>

    <link name="environment_link">

      <!-- Visual mesh -->
      <visual name="environment_visual">

        <geometry>
          <mesh>
            <uri>model://niihan_environment/meshes/construction_site_m1.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </visual>


      <!-- Collision mesh -->
      <collision name="environment_collision">

        <geometry>
          <mesh>
            <uri>model://niihan_environment/meshes/constructionsite_model1.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>10000000.0</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>

      </collision>

    </link>

  </model>

</sdf>
