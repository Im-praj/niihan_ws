<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="construction_site_chunk5">
    <gravity>0 0 -9.81</gravity>
    <physics name="chunk5_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.08 0.08 0.08 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 30 0.35 -0.45 0.25</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>

    <model name="construction_site_chunk5">
      <static>true</static>
      <link name="environment">
        <!-- Collision-only legacy world. The unavailable visual GLB is not referenced. -->
        <collision name="ground_collision">
          <geometry><mesh>
            <uri>../models/construction_site_chunk5/collision/ground_collision.glb</uri>
          </mesh></geometry>
          <surface><friction><ode>
            <mu>0.75</mu><mu2>0.75</mu2><slip1>0</slip1><slip2>0</slip2>
          </ode></friction></surface>
        </collision>
        <collision name="site_static_collision">
          <geometry><mesh>
            <uri>../models/construction_site_chunk5/collision/site_static_collision.glb</uri>
          </mesh></geometry>
          <surface><friction><ode>
            <mu>0.75</mu><mu2>0.75</mu2><slip1>0</slip1><slip2>0</slip2>
          </ode></friction></surface>
        </collision>
      </link>
    </model>
  </world>
</sdf>
