<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- ============================================================
       Mast-mounted sensors: 360 panoramic RGB camera ring, PTZ
       camera, thermal camera, and 3D 360 LiDAR.
       Uses Gazebo Harmonic sensor definitions.
       All topics are namespaced under /niihan/sensors/... per
       naming convention.
       ============================================================ -->

  <!-- ============ 360 panoramic RGB camera ring (4x cameras) ============ -->
  <xacro:macro name="niihan_ring_camera" params="suffix yaw_deg">
    <link name="camera_${suffix}_link">
      <visual>
        <geometry><box size="0.03 0.03 0.03"/></geometry>
        <material name="camera_${suffix}_black"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <collision><geometry><box size="0.03 0.03 0.03"/></geometry></collision>
      <xacro:box_inertia mass="0.05" x="0.03" y="0.03" z="0.03"/>
    </link>
    <joint name="camera_${suffix}_joint" type="fixed">
      <parent link="mast_head_link"/>
      <child link="camera_${suffix}_link"/>
      <origin xyz="0.09 0 0.02" rpy="0 0 ${yaw_deg * pi / 180.0}"/>
    </joint>
    <gazebo reference="camera_${suffix}_link">
      <sensor type="camera" name="camera_${suffix}_sensor">
        <pose>0 0 0 3.1415926535 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15.0</update_rate>
        <topic>/niihan/sensors/panoramic/${suffix}/image_raw</topic>
        <gz:frame_id>camera_${suffix}_link</gz:frame_id>
        <camera name="${suffix}">
          <horizontal_fov>1.57</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:niihan_ring_camera suffix="front" yaw_deg="0"/>
  <xacro:niihan_ring_camera suffix="right" yaw_deg="-90"/>
  <xacro:niihan_ring_camera suffix="rear"  yaw_deg="180"/>
  <xacro:niihan_ring_camera suffix="left"  yaw_deg="90"/>

  <!-- ============ PTZ camera (pan + tilt revolute joints, zoom via param) ============ -->
  <link name="ptz_pan_link">
    <visual><geometry><cylinder radius="0.025" length="0.02"/></geometry>
      <material name="ptz_pan_grey"><color rgba="0.3 0.3 0.3 1"/></material></visual>
    <collision><geometry><cylinder radius="0.025" length="0.02"/></geometry></collision>
    <xacro:cylinder_inertia mass="0.08" r="0.025" h="0.02"/>
  </link>
  <joint name="ptz_pan_joint" type="revolute">
    <parent link="mast_head_link"/>
    <child link="ptz_pan_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="5" velocity="1.5"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="ptz_tilt_link">
    <visual><geometry><box size="0.035 0.03 0.03"/></geometry>
      <material name="ptz_tilt_black"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <collision><geometry><box size="0.035 0.03 0.03"/></geometry></collision>
    <xacro:box_inertia mass="0.07" x="0.035" y="0.03" z="0.03"/>
  </link>
  <joint name="ptz_tilt_joint" type="revolute">
    <parent link="ptz_pan_link"/>
    <child link="ptz_tilt_link"/>
    <origin xyz="0.02 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="0.8" effort="5" velocity="1.5"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <gazebo reference="ptz_tilt_link">
    <sensor type="camera" name="ptz_camera_sensor">
      <always_on>1</always_on>
      <update_rate>20.0</update_rate>
      <topic>/niihan/sensors/ptz/image_raw</topic>
      <gz:frame_id>ptz_tilt_link</gz:frame_id>
      <camera name="ptz">
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>100</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============ Thermal camera (detection-grade) ============ -->
  <link name="thermal_camera_link">
    <visual><geometry><box size="0.04 0.04 0.03"/></geometry>
      <material name="thermal_camera_darkred"><color rgba="0.2 0.05 0.05 1"/></material></visual>
    <collision><geometry><box size="0.04 0.04 0.03"/></geometry></collision>
    <xacro:box_inertia mass="0.06" x="0.04" y="0.04" z="0.03"/>
  </link>
  <joint name="thermal_camera_joint" type="fixed">
    <parent link="mast_head_link"/>
    <child link="thermal_camera_link"/>
    <origin xyz="0.09 0 -0.03" rpy="0 0 0"/>
  </joint>
  <gazebo reference="thermal_camera_link">
    <sensor type="camera" name="thermal_camera_sensor">
      <always_on>1</always_on>
      <update_rate>9.0</update_rate>
      <topic>/niihan/sensors/thermal/image_raw</topic>
      <gz:frame_id>thermal_camera_link</gz:frame_id>
      <camera name="thermal">
        <horizontal_fov>0.9</horizontal_fov>
        <image><width>320</width><height>240</height><format>L8</format></image>
        <clip><near>0.1</near><far>50</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============ 3D 360 LiDAR (SLAM/localisation + obstacle detection) ============ -->
  <link name="mast_lidar_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="lidar_link_black"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <xacro:cylinder_inertia mass="0.25" r="0.045" h="0.06"/>
  </link>
  <joint name="mast_lidar_joint" type="fixed">
    <parent link="mast_head_link"/>
    <child link="mast_lidar_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>
  <gazebo reference="mast_lidar_link">
    <sensor type="gpu_lidar" name="lidar_3d_sensor">
      <always_on>1</always_on>
      <update_rate>10.0</update_rate>
      <topic>/niihan/sensors/lidar</topic>
      <gz:frame_id>mast_lidar_link</gz:frame_id>
      <lidar>
        <scan>
          <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
          <vertical><samples>64</samples><resolution>1</resolution><min_angle>-0.12217</min_angle><max_angle>0.90757</max_angle></vertical>
        </scan>
        <range><min>0.2</min><max>60.0</max><resolution>0.01</resolution></range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
