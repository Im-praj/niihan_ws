<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- ============================================================
       Chassis-mounted sensors: GNSS+RTK, IMU, wheel encoder odometry,
       front/rear proximity (ultrasonic/ToF) sensors, contact bumper,
       work light, flood light, and dock-approach AprilTag fiducial
       camera. Uses Gazebo Harmonic sensor configurations.
       ============================================================ -->

  <!-- GNSS + RTK: publishes sensor_msgs/NavSatFix -->
  <link name="gnss_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="niihan_gnss_white"><color rgba="0.95 0.95 0.95 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
    </collision>
  </link>
  <joint name="gnss_joint" type="fixed">
    <parent link="mast_head_link"/>
    <child link="gnss_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>
  <gazebo reference="gnss_link">
    <sensor name="gnss_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/niihan/gnss/fix</topic>
      <gz:frame_id>gnss_link</gz:frame_id>
    </sensor>
  </gazebo>

  <!-- 2D LiDAR: publishes sensor_msgs/LaserScan on /scan for navigation/obstacle detection -->
  <link name="chassis_lidar_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="niihan_lidar_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_lidar_link"/>
    <origin xyz="0 0 ${chassis_height/2 + 0.03}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="chassis_lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <gz:frame_id>chassis_lidar_link</gz:frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <link name="imu_link">
    <inertial>
      <mass value="0.03"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000005" iyy="0.000005" izz="0.000005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="niihan_imu_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
    </collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/niihan/imu/data</topic>
      <gz:frame_id>imu_link</gz:frame_id>
    </sensor>
  </gazebo>

  <!-- Front proximity sensor (ultrasonic/ToF placeholder using ray sensor) -->
  <link name="prox_front_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.01 0.03 0.01"/></geometry>
      <material name="niihan_prox_front_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.01 0.03 0.01"/></geometry>
    </collision>
  </link>
  <joint name="prox_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prox_front_link"/>
    <origin xyz="${chassis_length/2} 0 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="prox_front_link">
    <sensor name="prox_front_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/niihan/proximity/front_range</topic>
      <gz:frame_id>prox_front_link</gz:frame_id>
      <lidar>
        <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
        <range><min>0.02</min><max>3.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Rear proximity sensor -->
  <link name="prox_rear_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.01 0.03 0.01"/></geometry>
      <material name="niihan_prox_rear_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.01 0.03 0.01"/></geometry>
    </collision>
  </link>
  <joint name="prox_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prox_rear_link"/>
    <origin xyz="${-chassis_length/2} 0 0" rpy="0 0 3.14159"/>
  </joint>
  <gazebo reference="prox_rear_link">
    <sensor name="prox_rear_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/niihan/proximity/rear_range</topic>
      <gz:frame_id>prox_rear_link</gz:frame_id>
      <lidar>
        <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
        <range><min>0.02</min><max>3.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Contact bumper (front) -->
  <link name="bumper_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.02 ${chassis_width*0.9} 0.05"/></geometry>
      <material name="niihan_bumper_yellow"><color rgba="0.9 0.7 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.02 ${chassis_width*0.9} 0.05"/></geometry>
    </collision>
  </link>
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper_link"/>
    <origin xyz="${chassis_length/2 + 0.01} 0 -0.02" rpy="0 0 0"/>
  </joint>
  <gazebo reference="bumper_link">
    <sensor name="bumper_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact><collision>bumper_link_collision</collision></contact>
      <topic>/niihan/bumper/contact</topic>
      <gz:frame_id>bumper_link</gz:frame_id>
    </sensor>
  </gazebo>

  <!-- Forward work light (fixed white) -->
  <link name="work_light_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.06 0.02"/></geometry>
      <material name="niihan_work_light_white"><color rgba="1 1 0.9 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.03 0.06 0.02"/></geometry>
    </collision>
  </link>
  <joint name="work_light_joint" type="fixed">
    <parent link="base_link"/>
    <child link="work_light_link"/>
    <origin xyz="${chassis_length/2 - 0.02} 0 0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="work_light_link">
    <light name="work_light" type="spot">
      <cast_shadows>false</cast_shadows>
      <diffuse>1 1 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>15</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.0</quadratic></attenuation>
      <direction>1 0 0</direction>
      <spot><inner_angle>0.5</inner_angle><outer_angle>0.9</outer_angle><falloff>1.0</falloff></spot>
    </light>
  </gazebo>

  <!-- Controllable flood/spot/IR light -->
  <link name="flood_light_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.05 0.03"/></geometry>
      <material name="niihan_flood_light_dark"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.03 0.05 0.03"/></geometry>
    </collision>
  </link>
  <joint name="flood_light_joint" type="fixed">
    <parent link="mast_head_link"/>
    <child link="flood_light_link"/>
    <origin xyz="0.03 0 0.03" rpy="0 0 0"/>
  </joint>
  <gazebo reference="flood_light_link">
    <light name="flood_light" type="spot">
      <cast_shadows>false</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>25</range><constant>0.3</constant><linear>0.03</linear><quadratic>0.0</quadratic></attenuation>
      <direction>1 0 0</direction>
      <spot><inner_angle>0.6</inner_angle><outer_angle>1.2</outer_angle><falloff>1.0</falloff></spot>
    </light>
  </gazebo>

  <!-- Dock-approach AprilTag fiducial detector camera -->
  <link name="fiducial_cam_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="niihan_fiducial_cam_black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
    </collision>
  </link>
  <joint name="fiducial_cam_joint" type="fixed">
    <parent link="base_link"/>
    <child link="fiducial_cam_link"/>
    <origin xyz="${-chassis_length/2 + 0.02} 0 0.03" rpy="0 0 3.14159"/>
  </joint>
  <gazebo reference="fiducial_cam_link">
    <sensor name="fiducial_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/niihan/dock/fiducial/image_raw</topic>
      <gz:frame_id>fiducial_cam_link</gz:frame_id>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>10</far></clip>
      </camera>
    </sensor>
  </gazebo>


  <!-- ============ Intel RealSense D435i ============ -->
  <link name="d435i_link">
    <visual>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
      <material name="d435i_aluminum"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
    </collision>
    <xacro:box_inertia mass="0.072" x="0.025" y="0.090" z="0.025"/>
  </link>

  <joint name="d435i_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435i_link"/>
    <origin xyz="0.36 0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- Optical frames -->
  <link name="d435i_color_optical_frame"/>
  <joint name="d435i_color_optical_joint" type="fixed">
    <parent link="d435i_link"/>
    <child link="d435i_color_optical_frame"/>
    <origin xyz="0 0.015 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="d435i_depth_optical_frame"/>
  <joint name="d435i_depth_optical_joint" type="fixed">
    <parent link="d435i_link"/>
    <child link="d435i_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="d435i_imu_frame"/>
  <joint name="d435i_imu_joint" type="fixed">
    <parent link="d435i_link"/>
    <child link="d435i_imu_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Sensors -->
  <!-- RGB Camera -->
  <gazebo reference="d435i_color_optical_frame">
    <sensor type="camera" name="d435i_color_sensor">
      <always_on>1</always_on>
      <update_rate>30.0</update_rate>
      <topic>/niihan/sensors/d435i/color/image_raw</topic>
      <gz:frame_id>d435i_color_optical_frame</gz:frame_id>
      <camera name="d435i_color">
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Depth Camera -->
  <gazebo reference="d435i_depth_optical_frame">
    <sensor type="depth_camera" name="d435i_depth_sensor">
      <always_on>1</always_on>
      <update_rate>30.0</update_rate>
      <topic>/niihan/sensors/d435i/depth/image_raw</topic>
      <gz:frame_id>d435i_depth_optical_frame</gz:frame_id>
      <camera name="d435i_depth">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <gazebo reference="d435i_imu_frame">
    <sensor type="imu" name="d435i_imu_sensor">
      <always_on>1</always_on>
      <update_rate>200.0</update_rate>
      <topic>/niihan/sensors/d435i/imu/data</topic>
      <gz:frame_id>d435i_imu_frame</gz:frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
